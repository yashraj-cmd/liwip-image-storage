# --- authentication (email code sign-in) ---
# Generate with:  npx auth secret
AUTH_SECRET=

# How the six digit sign-in codes are delivered.
#
# Preferred: Gmail API with OAuth. The refresh token only needs the narrow
# scope https://www.googleapis.com/auth/gmail.send
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=Liwip SKU Images

# Alternative: plain SMTP with a Google App Password (Google Account ->
# Security -> App passwords). Only used when the OAuth values above are unset.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=

# Who may receive a sign-in code. Set at least one, or nobody can get in.
# Comma separated.
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_DOMAINS=keystonecommerce.in

# Only needed in production, so callbacks resolve to the right host
# AUTH_URL=https://sku.example.com

# local | s3
STORAGE_DRIVER=local

# Label shown in the sidebar and as the first breadcrumb
MASTER_FOLDER_NAME=SKU Images

# --- local driver ---
# Relative to the project root, or an absolute path
LOCAL_STORAGE_ROOT=data/sku-master

# --- s3 driver (only read when STORAGE_DRIVER=s3) ---
S3_BUCKET=
AWS_REGION=ap-south-1
# Optional key prefix inside the bucket, e.g. sku-master
S3_PREFIX=
# Seconds a presigned image URL stays valid
S3_SIGNED_URL_TTL=300
# Omit both to use the default AWS provider chain (IAM role, shared config)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional, for S3-compatible storage (MinIO, R2)
S3_ENDPOINT=
